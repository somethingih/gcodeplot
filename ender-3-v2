# Ender 3 V2 / Marlin defaults
machine-profile=ender3v2
no-allow-repeats
gcode-pause=M0
scale=none
align-x=none
align-y=none
tolerance=0.05
no-send
send-speed=115200
area=0,0,220,220
input-dpi=1016,1016
safe-delta-z=20
lift-delta-z=4
pen-up-speed=40
pen-down-speed=35
z-speed=5
curve-smoothing=0.35
min-path-length=0
work-z=15
no-hpgl-out
shading-threshold=1
shading-lightest=3
shading-darkest=0.5
shading-angle=45
no-shading-crosshatch
no-stroke-all
optimization-time=30
no-sort
no-pause-at-start
extract-color=all
tool-offset=0.000
overcut=0.000
no-simulation
direction=none
lift-command=none
down-command=none
init-code=G21|G90|G28
end-code=M400|M84
comment-delimiters=;
